/* eddy — mt-ui-style semantic tokens, expanded once at startup. */
QWidget {
    font-family: "Noto Sans", sans-serif;
    font-size: 13px;
}
QToolTip {
    background-color: @raise2;
    color: @fg;
    border: none;
    border-radius: 9px;
    padding: 6px 9px;
    font-family: "Noto Sans", sans-serif;
    font-size: 11px;
    font-weight: 500;
}
QWidget#EditorRoot { background-color: @bg; }

QWidget#Toolbar, QWidget#ViewControls {
    background-color: @bar;
    border: none;
    border-radius: 0;
}
QWidget#ToolRail { background-color: transparent; }

QToolButton {
    background-color: transparent;
    color: @sub;
    border: none;
    border-radius: 9px;
    font-family: "Noto Sans", sans-serif;
    font-size: 12px;
    font-weight: 500;
}
QToolButton:disabled { color: @faint; }
QToolButton:focus { background-color: @raise2; color: @fg; }
QToolButton:hover { background-color: @raise2; color: @fg; }
QToolButton:checked { background-color: @chip-on; color: @chip-on-fg; }
QToolButton:checked:hover { background-color: @chip-on; color: @chip-on-fg; }
QToolButton#WidthS:checked, QToolButton#WidthM:checked, QToolButton#WidthL:checked {
    background-color: @raise3;
    color: @fg;
}

QToolButton#SendToShelf {
    padding-left: 8px;
    padding-right: 8px;
}

QWidget#ColorPopover {
    background-color: @raise1;
    border: none;
    border-radius: 14px;
}
QWidget#RedactBar, QWidget#TextBar, QWidget#SpotlightBar {
    background-color: @raise1;
    border: none;
    /* 8px chip inset by the 3px margin: any larger and these bars round off
       into a stadium. */
    border-radius: 11px;
}
QWidget#RedactBar QToolButton, QWidget#TextBar QToolButton, QWidget#SpotlightBar QToolButton {
    color: @sub;
    padding: 0 8px;
    border-radius: 8px;
    font-family: "Noto Sans", sans-serif;
    font-size: 11px;
    font-weight: 500;
}
/* The text bar is icons throughout, letterforms included: padding would clip
   the wider glyphs at 20px. */
QWidget#TextBar QToolButton { padding: 0; }
QWidget#RedactBar QToolButton:hover, QWidget#TextBar QToolButton:hover, QWidget#SpotlightBar QToolButton:hover { background-color: @raise2; color: @fg; }
QWidget#RedactBar QToolButton:checked, QWidget#TextBar QToolButton:checked, QWidget#SpotlightBar QToolButton:checked { background-color: @raise3; color: @fg; }

QWidget#PlaybackBar {
    background-color: @bar;
    border: none;
    border-radius: 0;
}
QWidget#PlaybackBar QToolButton {
    background-color: transparent;
    border-radius: 6px;
    color: @sub;
    padding: 0 5px;
    font-size: 12px;
    font-weight: 500;
}
QWidget#PlaybackBar QToolButton:hover,
QWidget#PlaybackBar QToolButton:focus { background-color: @bar-hover; color: @fg; }
QWidget#PlaybackBar QToolButton:pressed { background-color: @bar-active; }
QWidget#PlaybackBar QToolButton#PlaybackPlay,
QWidget#PlaybackBar QToolButton#PlaybackMute,
QWidget#PlaybackBar QToolButton#TrimReset { padding: 0; }
QWidget#PlaybackBar QLabel {
    color: @sub;
    font-family: "MonoLisa", "Geist Mono", monospace;
    font-size: 11px;
    font-weight: 400;
}
QWidget#PlaybackBar QLabel#PlaybackTime { color: @fg; }
QWidget#PlaybackBar QSlider::groove:horizontal {
    height: 3px;
    background: @bar-active;
    border-radius: 1px;
}
QWidget#PlaybackBar QSlider::sub-page:horizontal {
    background: @sub;
    border-radius: 1px;
}
QWidget#PlaybackBar QSlider::handle:horizontal {
    width: 8px;
    margin: -3px 0;
    border-radius: 3px;
    background: @sub;
}
QWidget#PlaybackBar QSlider::handle:horizontal:hover { background: @fg; }

QWidget#Toast {
    background-color: @raise1;
    border: none;
    border-radius: 14px;
}
QLabel#ToastText {
    color: @fg;
    font-family: "Noto Sans", sans-serif;
    font-size: 12px;
}

QWidget#DragPill {
    background-color: transparent;
    border: none;
    border-radius: 9px;
}
QWidget#DragPill:hover { background-color: @bar-hover; }
QWidget#DragPill:disabled { background-color: transparent; }
QLabel#DragPillText {
    color: @fg;
    font-family: "Noto Sans", sans-serif;
    font-size: 12px;
    font-weight: 500;
}
QLabel#DragPillText:disabled { color: @faint; }

QToolButton#Save { color: @fg; }

QToolButton#ZoomFit, QToolButton#ZoomActual {
    background-color: transparent;
    padding: 0 8px;
    font-size: 11px;
}
QToolButton#ZoomFit:hover, QToolButton#ZoomActual:hover { background-color: @raise2; color: @fg; }

/* Vis bar geometry: flat surfaces, 22px controls, squircle state fills. */
QWidget#Toolbar QToolButton, QWidget#ToolRail QToolButton,
QWidget#ViewControls QToolButton, QWidget#DragPill {
    border-radius: 8px;
    font-weight: 500;
}
QWidget#Toolbar QToolButton, QWidget#ViewControls QToolButton {
    color: @fg;
}
QWidget#Toolbar QToolButton:disabled, QWidget#ViewControls QToolButton:disabled {
    color: @faint;
}
QWidget#Toolbar QToolButton:hover, QWidget#ToolRail QToolButton:hover,
QWidget#ViewControls QToolButton:hover {
    background-color: @bar-hover;
    color: @fg;
}
QWidget#Toolbar QToolButton:checked, QWidget#ToolRail QToolButton:checked,
QWidget#Toolbar QToolButton:checked:hover, QWidget#ToolRail QToolButton:checked:hover {
    background-color: @bar-active;
    color: @fg;
}
QLabel#DragPillText { font-weight: 500; }

/* Labelled bar actions carry 14px so the text is not dwarfed by an 18px icon. */
QWidget#Toolbar QToolButton, QWidget#ViewControls QToolButton,
QLabel#DragPillText { font-size: 14px; font-weight: 500; }

/* The footer uses the user's local MonoLisa for a softer, distinctive rhythm. */
QWidget#ViewControls QToolButton, QLabel#DragPillText {
    font-family: "MonoLisa", "Geist Mono", monospace;
    font-size: 12px;
    font-weight: 400;
}
QLineEdit#ColorHex {
    background-color: @raise2;
    color: @fg;
    border: none;
    border-radius: 6px;
    padding: 0 10px;
    font-family: "MonoLisa", monospace;
    font-size: 12px;
    selection-background-color: @raise3;
}
QLineEdit#ColorHex:focus { background-color: @raise3; }
QWidget#ColorPopover QToolButton {
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
}
QWidget#ColorPopover QToolButton#Custom,
QWidget#ColorPopover QToolButton#Pipette {
    color: @fg;
    background-color: @raise2;
}
QWidget#ColorPopover QToolButton:hover,
QWidget#ColorPopover QToolButton:focus { background-color: @raise3; }
QWidget#ColorPopover QToolButton:checked { background-color: @raise3; }
