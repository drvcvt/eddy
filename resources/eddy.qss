/* eddy: semantic tokens, expanded once at startup (theme::styleSheet, docs/design.md).
   Sizes: @fs-caption 12, @fs-ui 15; @ctl 28 control height; @s1..@s4 spacing;
   @r-chip 6, @r-bar 10 (= chip + @s1), @r-pop 14. */
QWidget {
    font-family: @font-ui;
    font-size: @fs-ui;
}
QToolTip, QLabel#CompactTooltip {
    background-color: @raise2;
    color: @fg;
    border: none;
    border-radius: @r-chip;
    padding: @s1 @s2;
    font-family: @font-ui;
    font-size: @fs-caption;
    font-weight: 500;
}
QWidget#EditorRoot { background-color: @bg; }

QWidget#Toolbar, QWidget#ViewControls {
    background-color: @bar;
    border: none;
    border-radius: 0;
}
QWidget#ToolRail { background-color: transparent; }

QToolButton {
    background-color: transparent;
    color: @sub;
    border: none;
    border-radius: @r-chip;
    font-family: @font-ui;
    font-size: @fs-ui;
    font-weight: 500;
}
QToolButton:disabled { color: @faint; }
/* No native menu arrows: hold-to-open buttons show none, and the menu buttons
   carry theme::setMenuArrow's rounded, filled one instead. */
QToolButton::menu-indicator { image: none; width: 0; height: 0; }
/* Hover fills come from HoverFills (app/hoverfill.cpp), eased with motion::kFast;
   the sheet only brightens the label. */
QToolButton:hover { color: @fg; }
/* Keyboard focus is a step quieter than hover, so a button a popup returned focus to
   does not look hovered. */
QToolButton:focus { color: @fg; }
QToolButton:checked { background-color: @chip-on; color: @chip-on-fg; }
QToolButton:checked:hover { background-color: @chip-on; color: @chip-on-fg; }
/* The line widths and the tools show one fill that glides between them (SelectionGlide). */
QToolButton#WidthS:checked, QToolButton#WidthM:checked, QToolButton#WidthL:checked {
    background-color: transparent;
    color: @fg;
}

/* One menu style for every menu: rows a control high, the panel @s1 around them. */
QMenu {
    background-color: @raise1;
    color: @sub;
    border: none;
    border-radius: @r-bar;
    padding: @s1;
    font-family: @font-ui;
    font-size: @fs-ui;
    font-weight: 500;
}
QMenu::item {
    min-width: 44px;
    padding: 4px @s2;    /* 4 + 19 px line + 4 + 1 px margin each side: one @ctl row */
    margin: 1px 0;
    border: none;
    border-radius: @r-chip;
    background-color: transparent;
}
QMenu::item:checked { background-color: @raise2; color: @fg; }
QMenu::item:selected { background-color: @raise3; color: @fg; }
QMenu::item:disabled { color: @faint; }
/* The filled row marks the current choice, without a separate radio-button gutter. */
QMenu::indicator { image: none; width: 0; height: 0; }
QMenu::separator { height: 1px; background: @raise2; margin: @s1 @s2; }
QMenu::icon { padding-left: @s1; }
/* Rates, scales and speeds are technical values like the timecodes beside them. */
QMenu#PlaybackRateMenu, QMenu#ZoomScaleMenu, QMenu#FragmentSpeedMenu { font-family: @font-mono; font-weight: 400; }
/* Carries the export panel, which draws its own surface. */
QMenu#ExportMenu { background: transparent; border: none; padding: 0; }

/* Studio being on is a document state, not the primary action: one step up. */
QToolButton#Studio:checked, QToolButton#Studio:checked:hover { background-color: @raise3; color: @fg; }

QWidget#ColorPopover {
    background-color: @raise1;
    border: none;
    border-radius: @r-pop;
}
QWidget#RedactBar, QWidget#TextBar, QWidget#SpotlightBar, QWidget#StepBar, QWidget#SelectionBar,
QWidget#CropBar, QWidget#ZoomBar, QWidget#FragmentBar {
    background-color: @raise1;
    border: none;
    border-radius: @r-bar;   /* @r-chip chips inset by @s1: concentric */
}
QWidget#RedactBar QToolButton, QWidget#SpotlightBar QToolButton, QWidget#StepBar QToolButton,
QWidget#CropBar QToolButton, QWidget#ZoomBar QToolButton, QWidget#FragmentBar QToolButton {
    color: @sub;
    padding: 0 @s2;
    border-radius: @r-chip;
    font-size: @fs-caption;
    font-weight: 500;
}
/* The text, step and selection bars are icons throughout, letterforms included. */
QWidget#TextBar QToolButton, QWidget#StepBar QToolButton, QWidget#SelectionBar QToolButton {
    padding: 0;
    border-radius: @r-chip;
}
QWidget#RedactBar QToolButton:hover, QWidget#TextBar QToolButton:hover, QWidget#SpotlightBar QToolButton:hover,
QWidget#StepBar QToolButton:hover, QWidget#SelectionBar QToolButton:hover, QWidget#CropBar QToolButton:hover,
QWidget#ZoomBar QToolButton:hover, QWidget#FragmentBar QToolButton:hover { color: @fg; }
QWidget#RedactBar QToolButton:checked, QWidget#TextBar QToolButton:checked, QWidget#SpotlightBar QToolButton:checked,
QWidget#StepBar QToolButton:checked, QWidget#ZoomBar QToolButton#ZoomTarget:checked { background-color: @raise3; color: @fg; }
QWidget#ZoomBar QToolButton#ZoomTarget:disabled { color: @faint; }
QWidget#ZoomBar QToolButton#ZoomScale, QWidget#FragmentBar QToolButton#FragmentSpeed { font-family: @font-mono; font-weight: 400; }
QWidget#CropBar QToolButton#CropApply { background: @chip-on; color: @chip-on-fg; }
QWidget#CropBar QToolButton#CropApply:hover { background: @fg; color: @bg; }
QWidget#CropBar QLabel { color: @sub; font-family: @font-mono; font-size: @fs-caption; padding: 0 @s2; }
QLineEdit#StepNumber {
    background-color: @raise2;
    color: @fg;
    border: none;
    border-radius: @r-chip;
    padding: 0 @s1;
    font-family: @font-mono;
    font-size: @fs-caption;
    selection-background-color: @raise3;
}
QLineEdit#StepNumber:focus { background-color: @raise3; }

QWidget#PlaybackBar {
    background-color: @bar;
    border: none;
    border-radius: 0;
}
QWidget#PlaybackBar QToolButton {
    background-color: transparent;
    border-radius: @r-chip;
    color: @sub;
    padding: 0 @s2;
    /* Start/End sit beside the Duration caption and the timecodes: one step. */
    font-size: @fs-caption;
    font-weight: 500;
}
QWidget#PlaybackBar QToolButton:hover { color: @fg; }
QWidget#PlaybackBar QToolButton:focus { color: @fg; }
QWidget#PlaybackBar QToolButton:pressed { background-color: @bar-active; }
QWidget#PlaybackBar QToolButton:checked { background-color: @bar-active; color: @fg; }
QWidget#PlaybackBar QToolButton#PlaybackPlay,
QWidget#PlaybackBar QToolButton#PlaybackMute,
QWidget#PlaybackBar QToolButton#TrimReset,
QWidget#PlaybackBar QToolButton#PlaybackLoop { padding: 0; }
QWidget#PlaybackBar QToolButton#PlaybackSpeed { font-family: @font-mono; font-weight: 400; }
QWidget#PlaybackBar QLabel {
    color: @sub;
    font-family: @font-mono;
    font-size: @fs-caption;
    font-weight: 400;
}
QWidget#PlaybackBar QLabel#PlaybackTime { color: @fg; }
/* Start, End and Duration read as three equal caption/value pairs. */
QWidget#PlaybackBar QLabel#TrimDurationCaption { font-family: @font-ui; font-weight: 500; padding: 0 @s2; }
QWidget#PlaybackBar QLabel#TrimDuration { color: @fg; padding: 0 @s2; }
QLabel#VideoExportStatus { color: @sub; font-size: @fs-caption; padding: 0 @s2; }
QWidget#PlaybackBar QLabel#NoAudio { color: @sub; font-family: @font-ui; font-size: @fs-caption; padding: 0 @s1; }
QWidget#PlaybackBar QLineEdit {
    background: transparent;
    color: @fg;
    border: none;
    border-radius: @r-chip;
    padding: 0 @s2;
    font-family: @font-mono;
    font-size: @fs-caption;
}
QWidget#PlaybackBar QLineEdit:hover { background: @bar-hover; }
QWidget#PlaybackBar QLineEdit:focus { background: @bar-active; color: @fg; }
QWidget#VideoPreview { background: @raise1; border: none; border-radius: @r-bar; }
QWidget#VideoPreview QLabel { color: @fg; font-family: @font-mono; font-size: @fs-caption; }
QSlider::groove:horizontal {
    height: 4px;
    background: @raise3;
    border-radius: 2px;
}
QSlider::sub-page:horizontal { background: @sub; border-radius: 2px; }
QSlider::sub-page:horizontal:disabled { background: @raise3; }
QSlider::handle:horizontal {
    width: 12px;
    margin: -4px 0;   /* 12 px knob on the 4 px groove */
    border-radius: 6px;
    background: @sub;
}
QSlider::handle:horizontal:hover { background: @fg; }
QSlider::handle:horizontal:disabled { background: @raise3; }
QWidget#PlaybackBar QSlider::groove:horizontal { background: @bar-active; }

QWidget#Toast {
    background-color: @raise1;
    border: none;
    border-radius: @r-pop;
}
QLabel#ToastText {
    color: @fg;
    font-family: @font-ui;
    font-size: @fs-ui;
}
QToolButton#ToastAction {
    background: @fg; color: @bg; border: none; border-radius: @r-chip;
    padding: 0 @s3; font-size: @fs-ui; font-weight: 600;
}

QWidget#DragPill {
    background-color: transparent;
    border: none;
    border-radius: @r-chip;
}
QWidget#DragPill:hover, QWidget#DragPill:focus { background-color: @bar-hover; }
QWidget#DragPill:disabled { background-color: transparent; }
QLabel#DragPillText {
    color: @fg;
    font-family: @font-mono;
    font-size: @fs-caption;
    font-weight: 400;
}
QLabel#DragPillText:disabled { color: @faint; }

QToolButton#Save { color: @fg; }

/* Flat bars: no surface around controls, state fills only. */
QWidget#Toolbar QToolButton, QWidget#ToolRail QToolButton, QWidget#ViewControls QToolButton {
    border-radius: @r-chip;
    font-weight: 500;
}
QWidget#Toolbar QToolButton, QWidget#ViewControls QToolButton { color: @fg; }
QWidget#Toolbar QToolButton:disabled, QWidget#ViewControls QToolButton:disabled { color: @faint; }
QWidget#Toolbar QToolButton:hover, QWidget#ToolRail QToolButton:hover,
QWidget#ViewControls QToolButton:hover {
    color: @fg;
}
QWidget#Toolbar QToolButton:checked, QWidget#Toolbar QToolButton:checked:hover {
    background-color: @bar-active;
    color: @fg;
}
QWidget#ToolRail QToolButton:checked, QWidget#ToolRail QToolButton:checked:hover,
QWidget#Toolbar QToolButton#WidthS:checked, QWidget#Toolbar QToolButton#WidthM:checked,
QWidget#Toolbar QToolButton#WidthL:checked {
    background-color: transparent;
    color: @fg;
}
/* The footer's zoom readout runs in the user's fixed font, like every value. */
QWidget#ViewControls QToolButton {
    padding: 0 @s2;
    font-family: @font-mono;
    font-size: @fs-caption;
    font-weight: 400;
}
QLineEdit#ColorHex {
    background-color: @raise2;
    color: @fg;
    border: none;
    border-radius: @r-chip;
    padding: 0 @s2;
    font-family: @font-mono;
    font-size: @fs-caption;
    selection-background-color: @raise3;
}
QLineEdit#ColorHex:focus { background-color: @raise3; }
QWidget#ColorPopover QToolButton {
    border-radius: @r-chip;
    font-size: @fs-ui;
    font-weight: 500;
}
QWidget#ColorPopover QToolButton#Custom,
QWidget#ColorPopover QToolButton#Pipette {
    color: @fg;
    background-color: @raise2;
}
QWidget#ColorPopover QToolButton#Custom:hover, QWidget#ColorPopover QToolButton#Pipette:hover { background-color: @raise3; }
QWidget#ColorPopover QToolButton:checked { background-color: @raise3; }

QWidget#StudioPopover {
    background-color: @raise1;
    border: none;
    border-radius: @r-pop;
}
/* Section heads: the label colour at a heavier weight, never a quiet grey. */
QWidget#StudioPopover QLabel#StudioSection { color: @sub; font-size: @fs-caption; font-weight: 600; }
QWidget#StudioPopover QLabel#StudioLabel { color: @sub; font-size: @fs-ui; }
QWidget#StudioPopover QLabel#StudioSize { color: @sub; font-family: @font-mono; font-size: @fs-caption; }
QWidget#StudioPopover QLabel:disabled { color: @faint; }
QWidget#StudioPopover QToolButton {
    border-radius: @r-chip;
    padding: 0 @s2;
    font-size: @fs-ui;
    font-weight: 500;
}
QWidget#StudioPopover QToolButton#StudioBackground { padding: 0; }
QWidget#StudioPopover QToolButton#StudioPage { font-weight: 600; }
QWidget#StudioPopover QToolButton:hover { color: @fg; }
QWidget#StudioPopover QToolButton:checked { background-color: @raise3; color: @fg; }

QWidget#MiniMap { background: @raise1; border: none; border-radius: @r-bar; }
/* Resume: the kept edits, newest first. */
QDialog#ResumeDialog { background: @raise1; }
QDialog#ResumeDialog QListWidget { background: @raise1; border: none; outline: 0; color: @fg; font-size: @fs-ui; }
QDialog#ResumeDialog QListWidget::item { padding: @s2; border-radius: @r-chip; }
QDialog#ResumeDialog QListWidget::item:selected { background: @raise3; color: @fg; }
QDialog#ResumeDialog QLabel#ResumeEmpty { color: @sub; font-size: @fs-ui; }
QDialog#ResumeDialog QToolButton { color: @sub; border: none; border-radius: @r-chip; padding: 0 @s3; font-size: @fs-ui; font-weight: 500; }
QDialog#ResumeDialog QToolButton:hover { color: @fg; }
QDialog#ResumeDialog QToolButton#ResumeOpen { background: @fg; color: @bg; font-weight: 600; }
/* Export popover at Save: segmented rows, the choice a step brighter. */
QWidget#ExportPanel { background-color: @raise1; border: none; border-radius: @r-pop; }
QWidget#ExportPanel QLabel#ExportSection { color: @sub; font-size: @fs-caption; font-weight: 600; }
QWidget#ExportPanel QLabel#ExportLabel { color: @sub; font-size: @fs-ui; }
QWidget#ExportPanel QLabel#ExportSummary { color: @sub; font-family: @font-mono; font-size: @fs-caption; }
QWidget#ExportPanel QWidget#ExportSegments { background-color: @raise2; border-radius: @r-bar; }
QWidget#ExportPanel QToolButton#ExportSegment {
    color: @sub; background: transparent; border: none; border-radius: @r-chip;
    padding: 0 @s2; font-size: @fs-ui; font-weight: 500;
}
QWidget#ExportPanel QToolButton#ExportSegment:hover { color: @fg; }
QWidget#ExportPanel QToolButton#ExportSegment:checked { background-color: @segment-on; color: @fg; }
QWidget#ExportPanel QToolButton#ProjectSave, QWidget#ExportPanel QToolButton#ProjectOpen,
QWidget#ExportPanel QToolButton#ProjectResume {
    color: @sub; background: transparent; border: none; border-radius: @r-chip;
    padding: 0 @s2; font-size: @fs-ui; font-weight: 500;
}
QWidget#ExportPanel QToolButton#ProjectSave:hover, QWidget#ExportPanel QToolButton#ProjectOpen:hover,
QWidget#ExportPanel QToolButton#ProjectResume:hover { color: @fg; }
QWidget#ExportPanel QToolButton#ExportSave {
    background: @fg; color: @bg; border: none; border-radius: @r-chip;
    padding: 0 @s3; font-size: @fs-ui; font-weight: 600;
}
