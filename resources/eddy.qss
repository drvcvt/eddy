/* eddy — mt-ui-style semantic tokens, expanded once at startup. */
QWidget {
    font-family: @font-ui;
    font-size: @fs-small;
}
QToolTip, QLabel#CompactTooltip {
    background-color: @raise2;
    color: @fg;
    border: none;
    border-radius: 6px;
    padding: 4px 6px;
    font-family: @font-ui;
    font-size: @fs-micro;
    font-weight: 500;
}
QWidget#EditorRoot { background-color: @bg; }

QWidget#Toolbar, QWidget#ViewControls {
    background-color: @bar;
    border: none;
    border-radius: 0;
}
QWidget#ToolRail { background-color: transparent; }

QToolButton {
    background-color: transparent;
    color: @sub;
    border: none;
    border-radius: 9px;
    font-family: @font-ui;
    font-size: @fs-small;
    font-weight: 500;
}
QToolButton:disabled { color: @faint; }
/* No native menu arrows: hold-to-open buttons show none, and the menu buttons
   carry theme::setMenuArrow's rounded, filled one instead. */
QToolButton#Copy::menu-indicator,
QToolButton#PlaybackMute::menu-indicator,
QToolButton#PlaybackSpeed::menu-indicator,
QToolButton#CropRatio::menu-indicator { image: none; width: 0; height: 0; }
QToolButton:focus { background-color: @raise2; color: @fg; }
QToolButton:hover { background-color: @raise2; color: @fg; }
QToolButton:checked { background-color: @chip-on; color: @chip-on-fg; }
QToolButton:checked:hover { background-color: @chip-on; color: @chip-on-fg; }
QToolButton#WidthS:checked, QToolButton#WidthM:checked, QToolButton#WidthL:checked {
    background-color: @raise3;
    color: @fg;
}

QMenu#PlaybackRateMenu {
    background-color: @raise1;
    color: @sub;
    border: none;
    border-radius: 10px;   /* 6px rows inset by the 4px padding */
    padding: 4px;
    font-size: @fs-small;
    font-weight: 500;
}
QMenu#PlaybackRateMenu::item {
    min-width: 44px;
    padding: 2px 8px;
    margin: 1px 0;
    border: none;
    border-radius: 6px;
    background-color: transparent;
}
QMenu#PlaybackRateMenu::item:checked { background-color: @raise2; color: @fg; }
QMenu#PlaybackRateMenu::item:selected { background-color: @raise3; color: @fg; }
/* The filled row marks the current rate, without a separate radio-button gutter. */
QMenu#PlaybackRateMenu::indicator { image: none; width: 0; height: 0; }

/* Studio being on is a document state, not the primary action: one step up. */
QToolButton#Studio:checked, QToolButton#Studio:checked:hover { background-color: @raise3; color: @fg; }

QWidget#ColorPopover {
    background-color: @raise1;
    border: none;
    border-radius: 14px;
}
QWidget#RedactBar, QWidget#TextBar, QWidget#SpotlightBar {
    background-color: @raise1;
    border: none;
    /* 8px chip inset by the 4px margin, so the gap stays concentric; any larger
       and these bars round off into a stadium. */
    border-radius: 12px;
}
QWidget#RedactBar QToolButton, QWidget#TextBar QToolButton, QWidget#SpotlightBar QToolButton {
    color: @sub;
    padding: 0 8px;
    border-radius: 8px;
    font-family: @font-ui;
    font-size: @fs-micro;
    font-weight: 500;
}
/* The text bar is icons throughout, letterforms included: padding would clip
   the wider glyphs at 20px. */
QWidget#TextBar QToolButton { padding: 0; }
QWidget#RedactBar QToolButton:hover, QWidget#TextBar QToolButton:hover, QWidget#SpotlightBar QToolButton:hover { background-color: @raise2; color: @fg; }
QWidget#RedactBar QToolButton:checked, QWidget#TextBar QToolButton:checked, QWidget#SpotlightBar QToolButton:checked { background-color: @raise3; color: @fg; }

QWidget#PlaybackBar {
    background-color: @bar;
    border: none;
    border-radius: 0;
}
QWidget#PlaybackBar QToolButton {
    background-color: transparent;
    border-radius: 6px;
    color: @sub;
    padding: 0 6px;
    /* Start/End sit beside the Duration caption and the timecodes: one step. */
    font-size: @fs-micro;
    font-weight: 500;
}
QWidget#PlaybackBar QToolButton:hover,
QWidget#PlaybackBar QToolButton:focus { background-color: @bar-hover; color: @fg; }
QWidget#PlaybackBar QToolButton:pressed { background-color: @bar-active; }
QWidget#PlaybackBar QToolButton:checked { background-color: @bar-active; color: @fg; }
QWidget#PlaybackBar QToolButton#PlaybackPlay,
QWidget#PlaybackBar QToolButton#PlaybackMute,
QWidget#PlaybackBar QToolButton#TrimReset,
QWidget#PlaybackBar QToolButton#PlaybackLoop { padding: 0; }
QWidget#PlaybackBar QLabel {
    color: @sub;
    font-family: @font-mono;
    font-size: @fs-micro;
    font-weight: 400;
}
QWidget#PlaybackBar QLabel#PlaybackTime { color: @fg; }
/* Start, End and Duration read as three equal caption/value pairs. */
QWidget#PlaybackBar QLabel#TrimDurationCaption { font-family: @font-ui; font-weight: 500; padding: 0 6px; }
QWidget#PlaybackBar QLabel#TrimDuration { color: @fg; padding: 0 6px; }
QLabel#VideoExportStatus { color: @sub; font-size: @fs-micro; padding-right: 8px; }
QWidget#PlaybackBar QLineEdit {
    background: transparent;
    color: @fg;
    border: none;
    border-radius: 6px;
    padding: 0 6px;
    font-family: @font-mono;
    font-size: @fs-micro;
}
QWidget#PlaybackBar QLineEdit:hover { background: @bar-hover; }
QWidget#PlaybackBar QLineEdit:focus { background: @bar-active; color: @fg; }
QWidget#VideoPreview { background: @raise1; border: none; border-radius: 8px; }
QWidget#VideoPreview QLabel { color: @fg; font-family: @font-mono; font-size: @fs-micro; }
QWidget#PlaybackBar QSlider::groove:horizontal {
    height: 4px;
    background: @bar-active;
    border-radius: 2px;
}
QWidget#PlaybackBar QSlider::sub-page:horizontal {
    background: @sub;
    border-radius: 2px;
}
QWidget#PlaybackBar QSlider::handle:horizontal {
    width: 8px;
    margin: -2px 0;   /* 8px square knob on the 4px groove */
    border-radius: 3px;
    background: @sub;
}
QWidget#PlaybackBar QSlider::handle:horizontal:hover { background: @fg; }

QWidget#Toast {
    background-color: @raise1;
    border: none;
    border-radius: 14px;
}
QLabel#ToastText {
    color: @fg;
    font-family: @font-ui;
    font-size: @fs-small;
}

QWidget#DragPill {
    background-color: transparent;
    border: none;
    border-radius: 9px;
}
QWidget#DragPill:hover, QWidget#DragPill:focus { background-color: @bar-hover; }
QWidget#DragPill:disabled { background-color: transparent; }
QLabel#DragPillText {
    color: @fg;
    font-family: @font-ui;
    font-size: @fs-small;
    font-weight: 500;
}
QLabel#DragPillText:disabled { color: @faint; }

QToolButton#Save { color: @fg; }

QToolButton#ZoomFit, QToolButton#ZoomActual {
    background-color: transparent;
    padding: 0 8px;
    font-size: @fs-micro;
}
QToolButton#ZoomFit:hover, QToolButton#ZoomActual:hover { background-color: @raise2; color: @fg; }

/* Vis bar geometry: flat surfaces, 22px controls, squircle state fills. */
QWidget#Toolbar QToolButton, QWidget#ToolRail QToolButton,
QWidget#ViewControls QToolButton, QWidget#DragPill {
    border-radius: 8px;
    font-weight: 500;
}
QWidget#Toolbar QToolButton, QWidget#ViewControls QToolButton {
    color: @fg;
}
QWidget#Toolbar QToolButton:disabled, QWidget#ViewControls QToolButton:disabled {
    color: @faint;
}
QWidget#Toolbar QToolButton:hover, QWidget#ToolRail QToolButton:hover,
QWidget#ViewControls QToolButton:hover {
    background-color: @bar-hover;
    color: @fg;
}
QWidget#Toolbar QToolButton:checked, QWidget#ToolRail QToolButton:checked,
QWidget#Toolbar QToolButton:checked:hover, QWidget#ToolRail QToolButton:checked:hover {
    background-color: @bar-active;
    color: @fg;
}
QLabel#DragPillText { font-weight: 500; }

/* Labelled bar actions sit on the small step, the largest the 22px chrome carries. */
QWidget#Toolbar QToolButton, QWidget#ViewControls QToolButton,
QLabel#DragPillText { font-size: @fs-small; font-weight: 500; }

/* The footer runs in the user's system fixed font for a softer, distinctive rhythm. */
QWidget#ViewControls QToolButton, QLabel#DragPillText {
    font-family: @font-mono;
    font-size: @fs-small;
    font-weight: 400;
}
QLineEdit#ColorHex {
    background-color: @raise2;
    color: @fg;
    border: none;
    border-radius: 6px;
    padding: 0 8px;
    font-family: @font-mono;
    font-size: @fs-small;
    selection-background-color: @raise3;
}
QLineEdit#ColorHex:focus { background-color: @raise3; }
QWidget#ColorPopover QToolButton {
    border-radius: 6px;
    font-size: @fs-small;
    font-weight: 500;
}
QWidget#ColorPopover QToolButton#Custom,
QWidget#ColorPopover QToolButton#Pipette {
    color: @fg;
    background-color: @raise2;
}
QWidget#ColorPopover QToolButton:hover,
QWidget#ColorPopover QToolButton:focus { background-color: @raise3; }
QWidget#ColorPopover QToolButton:checked { background-color: @raise3; }

QWidget#StudioPopover {
    background-color: @raise1;
    border: none;
    border-radius: 14px;
}
QWidget#StudioPopover QLabel#StudioSection {
    color: @faint;
    font-size: @fs-micro;
    font-weight: 600;
}
QWidget#StudioPopover QLabel#StudioLabel { color: @sub; font-size: @fs-small; }
QWidget#StudioPopover QLabel#StudioSize { color: @sub; font-family: @font-mono; font-size: @fs-micro; }
QWidget#StudioPopover QLabel:disabled { color: @faint; }
QWidget#StudioPopover QToolButton {
    border-radius: 6px;
    padding: 0 8px;
    font-size: @fs-small;
    font-weight: 500;
}
QWidget#StudioPopover QToolButton#StudioBackground { padding: 0; }
QWidget#StudioPopover QToolButton#StudioPage { font-size: @fs-small; font-weight: 600; }
QWidget#StudioPopover QToolButton:hover,
QWidget#StudioPopover QToolButton:focus { background-color: @raise2; color: @fg; }
QWidget#StudioPopover QToolButton:checked { background-color: @raise3; color: @fg; }
QWidget#StudioPopover QSlider::groove:horizontal { height: 4px; background: @raise3; border-radius: 2px; }
QWidget#StudioPopover QSlider::sub-page:horizontal { background: @sub; border-radius: 2px; }
QWidget#StudioPopover QSlider::sub-page:horizontal:disabled { background: @raise3; }
QWidget#StudioPopover QSlider::handle:horizontal {
    width: 8px;
    margin: -2px 0;
    border-radius: 3px;
    background: @sub;
}
QWidget#StudioPopover QSlider::handle:horizontal:hover { background: @fg; }
QWidget#StudioPopover QSlider::handle:horizontal:disabled { background: @raise3; }

/* Crop shares the floating annotation controls' compact geometry. */
QWidget#CropBar { background: @raise1; border: none; border-radius: 12px; }
QWidget#CropBar QToolButton {
    color: @sub; padding: 0 8px; border-radius: 8px;
    font-size: @fs-micro; font-weight: 500;
}
QWidget#CropBar QToolButton:hover, QWidget#CropBar QToolButton:focus {
    background: @raise2; color: @fg;
}
QWidget#CropBar QToolButton#CropApply { background: @chip-on; color: @chip-on-fg; }
QWidget#CropBar QToolButton#CropApply:hover, QWidget#CropBar QToolButton#CropApply:focus {
    background: @fg; color: @bg;
}
QWidget#CropBar QLabel { color: @sub; font-family: @font-mono; font-size: @fs-micro; padding: 0 6px; }
QMenu#CropRatioMenu { background: @raise1; color: @sub; border: none; border-radius: 10px; padding: 4px; font-size: @fs-small; font-weight: 500; }
QMenu#CropRatioMenu::item { padding: 2px 8px; margin: 1px 0; border: none; border-radius: 6px; background: transparent; }
QMenu#CropRatioMenu::item:checked { background: @raise2; color: @fg; }
QMenu#CropRatioMenu::item:selected { background: @raise3; color: @fg; }
QMenu#CropRatioMenu::indicator { image: none; width: 0; height: 0; }
/* The zoom bar shares the crop bar's floating geometry. */
QWidget#ZoomBar { background: @raise1; border: none; border-radius: 12px; }
QWidget#ZoomBar QToolButton {
    color: @sub; padding: 0 8px; border-radius: 8px;
    font-size: @fs-micro; font-weight: 500;
}
QWidget#ZoomBar QToolButton:hover, QWidget#ZoomBar QToolButton:focus { background: @raise2; color: @fg; }
QWidget#ZoomBar QToolButton#ZoomScale { font-family: @font-mono; font-weight: 400; }
QToolButton#ZoomScale::menu-indicator, QToolButton#ZoomMotion::menu-indicator { image: none; width: 0; height: 0; }
QMenu#ZoomScaleMenu, QMenu#ZoomMotionMenu { background: @raise1; color: @sub; border: none; border-radius: 10px; padding: 4px; font-size: @fs-small; font-weight: 500; }
QMenu#ZoomScaleMenu { font-family: @font-mono; font-weight: 400; }
QMenu#ZoomScaleMenu::item, QMenu#ZoomMotionMenu::item { padding: 2px 8px; margin: 1px 0; border: none; border-radius: 6px; background: transparent; }
QMenu#ZoomScaleMenu::item:checked, QMenu#ZoomMotionMenu::item:checked { background: @raise2; color: @fg; }
QMenu#ZoomScaleMenu::item:selected, QMenu#ZoomMotionMenu::item:selected { background: @raise3; color: @fg; }
QMenu#ZoomScaleMenu::indicator, QMenu#ZoomMotionMenu::indicator { image: none; width: 0; height: 0; }
QWidget#MiniMap { background: @raise1; border: none; border-radius: 10px; }
/* Export popover at Save: segmented rows (Q7 B2), the choice a step brighter. */
QMenu#ExportMenu { background: transparent; border: none; padding: 0; }
QWidget#ExportPanel { background-color: @raise1; border: none; border-radius: 14px; }
QWidget#ExportPanel QLabel#ExportSection { color: @faint; font-size: @fs-micro; font-weight: 600; }
QWidget#ExportPanel QLabel#ExportLabel { color: @sub; font-size: @fs-small; }
QWidget#ExportPanel QLabel#ExportSummary { color: @sub; font-family: @font-mono; font-size: @fs-micro; }
QWidget#ExportPanel QWidget#ExportSegments { background-color: @raise2; border-radius: 8px; }
QWidget#ExportPanel QToolButton#ExportSegment {
    color: @sub; background: transparent; border: none; border-radius: 6px;
    padding: 0 8px; font-size: @fs-small; font-weight: 500;
}
QWidget#ExportPanel QToolButton#ExportSegment:hover { color: @fg; }
QWidget#ExportPanel QToolButton#ExportSegment:checked { background-color: @segment-on; color: @fg; }
QWidget#ExportPanel QToolButton#ExportSave {
    background: @fg; color: @bg; border: none; border-radius: 8px;
    padding: 0 12px; font-size: @fs-small; font-weight: 600;
}
/* The one labelled chrome action: its text steps up to sit with the 18px icon. */
QWidget#Toolbar QToolButton#SendToShelf, QWidget#Toolbar QToolButton#Studio { font-size: @fs-body; }
/* Rates are technical values like the timecodes beside them. */
QWidget#PlaybackBar QToolButton#PlaybackSpeed, QMenu#PlaybackRateMenu { font-family: @font-mono; font-weight: 400; }
